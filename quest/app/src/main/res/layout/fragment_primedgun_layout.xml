     GPL-2.0-or-later). -->
<!-- The Layout tab: the controller binding diagram, scaled to fit the visible panel like the Qt
     window's PrimedGunScaledImageLabel. No scrolling: the diagram ends with an instruction line
     that must stay on screen, so the image shrinks to the space available instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        style="@style/PrimedGunSectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/primedgun_section_controller_layout" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="@string/primedgun_controller_layout_description"
        android:scaleType="fitCenter"
        android:src="@drawable/primedgun_controller_layout" />
</LinearLayout>
