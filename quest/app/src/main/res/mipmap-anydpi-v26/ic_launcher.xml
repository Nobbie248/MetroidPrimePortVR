<?xml version="1.0" encoding="utf-8"?>
<!-- PrimedGun's "P" (launcher/assets/PrimedGun.png, synced as primedgun_logo) on
     the launcher's background. minSdk is 29, so the adaptive form is the only one. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/primedgun_background" />
    <foreground>
        <inset
            android:drawable="@drawable/primedgun_logo"
            android:inset="22%" />
    </foreground>
</adaptive-icon>
