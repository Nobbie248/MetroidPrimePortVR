<!-- From PrimedGun's Quest launcher (res/layout/activity_main.xml, Copyright 2026 PrimedGun
     Project, GPL-2.0-or-later), with the PC launcher's unsaved-changes status in the footer. -->
<!-- The PrimedGun launcher window, laid out like MainWindow::ConnectStack(): a title bar, the
     tab strip, the tab content panel, and the Reset All / Save Settings / credit footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primedgun_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/primedgun_background"
        app:contentInsetStart="14dp"
        app:title="@string/primedgun_title"
        app:titleTextAppearance="@style/PrimedGunToolbarTitle"
        app:titleTextColor="@color/primedgun_text" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/main_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/primedgun_background"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/primedgun_accent"
        app:tabIndicatorHeight="2dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="14dp"
        app:tabPaddingStart="14dp"
        app:tabRippleColor="@color/primedgun_ripple"
        app:tabSelectedTextColor="@color/primedgun_text"
        app:tabTextAppearance="@style/PrimedGunTabText"
        app:tabTextColor="@color/primedgun_text_muted" />

    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/primedgun_panel_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@color/primedgun_separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/main_reset_all"
            style="@style/PrimedGunButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/primedgun_reset_all" />

        <Button
            android:id="@+id/main_save_settings"
            style="@style/PrimedGunButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="40dp"
            android:text="@string/primedgun_save_settings" />

        <TextView
            android:id="@+id/main_status"
            style="@style/PrimedGunMutedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/primedgun_accent_text"
            android:visibility="gone"
            tools:text="Unsaved changes"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/main_credit"
            style="@style/PrimedGunMutedLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textAlignment="viewEnd"
            tools:text="By Nobbie and iChris4   v2.0.0" />
    </LinearLayout>
</LinearLayout>
