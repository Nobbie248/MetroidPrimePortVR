<!-- From PrimedGun's Quest launcher (res/drawable/primedgun_control_background.xml, Copyright 2026 PrimedGun Project,
     GPL-2.0-or-later). -->
<!-- The QPushButton look from MainWindow's game_button_style, including its disabled state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/primedgun_control_disabled" />
            <stroke android:width="1dp" android:color="@color/primedgun_control_disabled" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primedgun_control_pressed" />
            <stroke android:width="1dp" android:color="@color/primedgun_accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primedgun_control" />
            <stroke android:width="1dp" android:color="@color/primedgun_control_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
